<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="kromodix-forgejo" value="https://git.flexfamily.cloud/api/packages/KroModIx/nuget/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="kromodix-forgejo">
      <package pattern="KroModIx.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
