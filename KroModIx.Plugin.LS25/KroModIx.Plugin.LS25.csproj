<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>KroModIx.Plugin.LS25</RootNamespace>
    <AssemblyName>KroModIx.Plugin.LS25</AssemblyName>
    <!-- Plugin-DLL braucht ihre transitiven Dependencies im Bundle
         (HtmlAgilityPack). Pfim/SkiaSharp sind ab v1.18.0 raus —
         DDS-Decode uebernimmt der Host-IImageDecoder. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- ExcludeAssets=runtime: kommt vom Host mit, nicht im Plugin-Bundle. -->
    <PackageReference Include="KroModIx.Plugin.Contracts"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="CommunityToolkit.Mvvm"
                      PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Plugin-spezifisch, muss ins Bundle: -->
    <PackageReference Include="HtmlAgilityPack" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
